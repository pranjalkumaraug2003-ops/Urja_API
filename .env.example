# Copy this file to .env and fill in the values. .env is git-ignored.

# Base URL of the Urja Meter Ops portal
PORTAL_URL=https://urja-ops.flockenergy.tech

# Portal login (operator account from the assignment brief)
PORTAL_EMAIL=
PORTAL_PASSWORD=

# Port this API listens on
PORT=3000

# How long to wait for one portal response before giving up (milliseconds)
PORTAL_TIMEOUT_MS=10000

# Minimum gap between two portal requests (milliseconds). 500 keeps us near 120 requests per minute.
PORTAL_MIN_INTERVAL_MS=500

{
  "openapi": "3.0.3",
  "info": {
    "title": "Urja Meter Ops API",
    "version": "1.0.0",
    "description": "A clean, documented API over the Urja Meter Ops smart-meter portal (which has no API of its own). Data is read from the portal, cleaned (types, ISO 8601 timestamps, repaired hierarchy), cached in memory, and served here. Every repair is listed in a `dataQuality` array. Every success response is `{ data, meta }`; every error is `{ error }`. Unknown query parameters are rejected with 400. Meters and DTs refresh every 15 minutes; past energy readings are cached for good. See PROTOCOL.md for how the portal works and README.md for design decisions."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development (port set by the PORT environment variable)"
    }
  ],
  "tags": [
    {
      "name": "Meters",
      "description": "Smart meters, their network position and their energy readings"
    },
    {
      "name": "Transformers",
      "description": "Distribution transformers (DTs)"
    },
    {
      "name": "Network",
      "description": "The network hierarchy, zone to DT"
    },
    {
      "name": "Operations",
      "description": "Service health"
    }
  ],
  "paths": {
    "/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List meters",
        "description": "Returns full, cleaned meter records, ordered by meterId, filtered and then paginated with limit and offset (meta.total counts the filtered meters). With near, results are ordered by distance instead. Filters run on the in-memory cache, so they cost no portal requests.",
        "operationId": "listMeters",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/InstallStatus"
          },
          {
            "$ref": "#/components/parameters/PhaseType"
          },
          {
            "$ref": "#/components/parameters/InstallType"
          },
          {
            "$ref": "#/components/parameters/Build"
          },
          {
            "$ref": "#/components/parameters/Make"
          },
          {
            "$ref": "#/components/parameters/Dt"
          },
          {
            "$ref": "#/components/parameters/Path"
          },
          {
            "$ref": "#/components/parameters/Q"
          },
          {
            "$ref": "#/components/parameters/Near"
          },
          {
            "$ref": "#/components/parameters/RadiusKm"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of meters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Meter"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PageMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/UpstreamUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/v1/meters/{meterId}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get one meter",
        "operationId": "getMeter",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "The meter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Meter"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/UpstreamUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/v1/meters/{meterId}/energy": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get energy readings for one meter",
        "description": "Returns cumulative register readings (kwh, kvah are odometer-style totals, not consumption) plus kwhDelta and kvahDelta, the usage during the interval ending at each timestamp. intervalMinutes is detected from the data (30 or 1440 in the current dataset). Both from and to are required, inclusive, and interpreted in IST; the range may span at most 31 days. A window with no data returns 200 with an empty readings list. The first reading in the window has kwhDelta and kvahDelta null, because there is no earlier reading in the window to subtract from; to get usage for the first interval, start the window one interval earlier (one day for daily meters). For daily meters, the reading at 00:00 carries the previous day's usage. With granularity=daily the response holds days instead of readings: each interval's usage counts for the IST day the interval started on (for daily meters the 02/06 reading is 1 June usage), a day is complete only if all its intervals had a delta inside the window, and a day with no usable interval is left out (for a daily meter, the last day of the window: its usage needs the next day's reading).",
        "operationId": "getMeterEnergy",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          },
          {
            "$ref": "#/components/parameters/Granularity"
          }
        ],
        "responses": {
          "200": {
            "description": "Readings for the requested window",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Energy"
                        },
                        {
                          "$ref": "#/components/schemas/DailyEnergy"
                        }
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/UpstreamUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/v1/network": {
      "get": {
        "tags": [
          "Network"
        ],
        "summary": "Network hierarchy tree",
        "description": "The network from zone down to DT, built from the cached meters (no extra portal calls). Each node has its level, code, name, path and meter counts by status; DT nodes list their meters. Codes repeat under different parents, so nodes are identified by path; summary.codesUnderMultipleParents says how often that happens.",
        "operationId": "getNetwork",
        "responses": {
          "200": {
            "description": "The tree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Network"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/UpstreamUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/v1/transformers": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "List distribution transformers",
        "description": "All DTs with their feeder, capacity, network path and number of meters. Small fixed list, so not paginated.",
        "operationId": "listTransformers",
        "responses": {
          "200": {
            "description": "All transformers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Transformer"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/UpstreamUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Service health",
        "description": "Reports process and cache status. Never calls the portal. Returns 200 while the process is running; status is degraded before the first successful load or when the last portal call failed. Not wrapped in the data/meta envelope, because it is read by monitoring tools.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MeterId": {
        "name": "meterId",
        "in": "path",
        "required": true,
        "description": "Meter ID. Case-insensitive (j100001 and J100001 are the same meter).",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "example": "J100001"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of items to return.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "Number of items to skip.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "From": {
        "name": "from",
        "in": "query",
        "required": true,
        "description": "First day of the window, inclusive, IST.",
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2026-06-01"
        }
      },
      "To": {
        "name": "to",
        "in": "query",
        "required": true,
        "description": "Last day of the window, inclusive (the whole day), IST. Must not be before from; at most 31 days after from counting both ends.",
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2026-06-03"
        }
      },
      "InstallStatus": {
        "name": "installStatus",
        "in": "query",
        "required": false,
        "description": "Keep meters with one of these statuses. Comma-separated.",
        "schema": {
          "type": "string",
          "example": "faulty,decommissioned"
        }
      },
      "PhaseType": {
        "name": "phaseType",
        "in": "query",
        "required": false,
        "description": "single or three. Comma-separated for several.",
        "schema": {
          "type": "string",
          "example": "three"
        }
      },
      "InstallType": {
        "name": "installType",
        "in": "query",
        "required": false,
        "description": "whole_current or ct_operated. Comma-separated for several.",
        "schema": {
          "type": "string",
          "example": "ct_operated"
        }
      },
      "Build": {
        "name": "build",
        "in": "query",
        "required": false,
        "description": "legacy or v2. Comma-separated for several.",
        "schema": {
          "type": "string",
          "example": "v2"
        }
      },
      "Make": {
        "name": "make",
        "in": "query",
        "required": false,
        "description": "Meter make, case-insensitive exact match.",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "example": "Genus"
        }
      },
      "Dt": {
        "name": "dt",
        "in": "query",
        "required": false,
        "description": "DT code, case-insensitive (DT codes are unique).",
        "schema": {
          "type": "string",
          "maxLength": 32,
          "example": "DT-007"
        }
      },
      "Path": {
        "name": "path",
        "in": "query",
        "required": false,
        "description": "A network path or the start of one: returns the meters under that node. Use paths, not single codes, because codes repeat under different parents. Case-insensitive.",
        "schema": {
          "type": "string",
          "maxLength": 200,
          "example": "Z-01/C-01"
        }
      },
      "Q": {
        "name": "q",
        "in": "query",
        "required": false,
        "description": "Substring of meterId or serialNo, case-insensitive.",
        "schema": {
          "type": "string",
          "maxLength": 32,
          "example": "10001"
        }
      },
      "Near": {
        "name": "near",
        "in": "query",
        "required": false,
        "description": "\"lat,lng\" in decimal degrees. Returns meters within radiusKm, nearest first, each with distanceKm. Meters without coordinates are left out.",
        "schema": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$",
          "example": "26.9124,75.7873"
        }
      },
      "RadiusKm": {
        "name": "radiusKm",
        "in": "query",
        "required": false,
        "description": "Search radius for near, in km (default 2, max 50). Only allowed with near.",
        "schema": {
          "type": "number",
          "exclusiveMinimum": true,
          "minimum": 0,
          "maximum": 50,
          "default": 2
        }
      },
      "Granularity": {
        "name": "granularity",
        "in": "query",
        "required": false,
        "description": "raw (default): every reading with its delta. daily: usage per IST calendar day.",
        "schema": {
          "type": "string",
          "enum": [
            "raw",
            "daily"
          ],
          "default": "raw"
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "description": "Freshness of the data in this response.",
        "required": [
          "fetchedAt",
          "stale"
        ],
        "properties": {
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this data was last fetched from the portal (UTC).",
            "example": "2026-11-04T08:15:00.000Z"
          },
          "stale": {
            "type": "boolean",
            "description": "True when the data is older than its freshness window: served while a refresh runs, or because the portal is unavailable.",
            "example": false
          }
        }
      },
      "PageMeta": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Meta"
          },
          {
            "type": "object",
            "required": [
              "total",
              "limit",
              "offset"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total number of items across all pages.",
                "example": 403
              },
              "limit": {
                "type": "integer",
                "example": 100
              },
              "offset": {
                "type": "integer",
                "example": 0
              }
            }
          }
        ]
      },
      "DataQualityIssue": {
        "type": "object",
        "description": "One repair or warning about the source data. Routine format conversions (numeric strings, date format) are not listed; content repairs are. Known issue / action pairs: blank_in_source / filled_from_dt_siblings, filled_from_portal_dts, filled_from_dt_code or left_null; not_a_number / left_null; conflicting_name_in_source / replaced_with_portal_dts_name (meters) or portal_dts_name_kept_alias_recorded (transformers); duplicate_incomplete_row or duplicate_row / dropped; invalid_timestamp / dropped; gap_before / delta_spans_gap; negative_delta / delta_set_null.",
        "required": [
          "issue",
          "action"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the affected field. On energy responses this names the reading field (kwh, kvah, voltageR, kwhDelta, kvahDelta).",
            "example": "hierarchy.circle.code"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the affected reading (energy responses).",
            "example": "2026-06-30T00:00:00+05:30"
          },
          "issue": {
            "type": "string",
            "example": "blank_in_source"
          },
          "action": {
            "type": "string",
            "example": "filled_from_dt_siblings"
          },
          "sourceValue": {
            "type": "string",
            "description": "The original portal value, when it was replaced or dropped.",
            "example": "Old Malviya Nagar Xfmr"
          }
        }
      },
      "HierarchyNode": {
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "nullable": true,
            "description": "Code of the node. Unique only within its parent, so use the path to identify a node.",
            "example": "C-06"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Circle 6"
          }
        }
      },
      "Hierarchy": {
        "type": "object",
        "description": "Position of a meter in the network, from zone down to DT.",
        "required": [
          "path",
          "zone",
          "circle",
          "division",
          "subdivision",
          "substation",
          "feeder",
          "dt"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Codes from zone to DT joined by '/'. This identifies a node, because codes repeat under different parents. A code that could not be repaired appears as 'unknown'.",
            "example": "Z-01/C-06/D-02/SD-03/SS-04/F-006/DT-011"
          },
          "zone": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "circle": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "division": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "subdivision": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "substation": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "feeder": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "dt": {
            "$ref": "#/components/schemas/HierarchyNode"
          }
        }
      },
      "Meter": {
        "type": "object",
        "required": [
          "meterId",
          "serialNo",
          "make",
          "phaseType",
          "installStatus",
          "installType",
          "build",
          "location",
          "hierarchy",
          "dataQuality"
        ],
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100011"
          },
          "serialNo": {
            "type": "string",
            "description": "Serial number. Its prefix does not indicate the make.",
            "example": "SE12345"
          },
          "make": {
            "type": "string",
            "example": "Genus"
          },
          "phaseType": {
            "type": "string",
            "enum": [
              "single",
              "three"
            ]
          },
          "installStatus": {
            "type": "string",
            "enum": [
              "installed",
              "faulty",
              "decommissioned"
            ],
            "description": "Decommissioned meters may still report readings; this is reported as the source states it."
          },
          "installType": {
            "type": "string",
            "enum": [
              "whole_current",
              "ct_operated"
            ]
          },
          "build": {
            "type": "string",
            "enum": [
              "legacy",
              "v2"
            ],
            "description": "Meter firmware/record generation as reported by the portal export."
          },
          "location": {
            "type": "object",
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "nullable": true,
                "example": 26.93896
              },
              "lng": {
                "type": "number",
                "nullable": true,
                "example": 75.83096
              }
            }
          },
          "hierarchy": {
            "$ref": "#/components/schemas/Hierarchy"
          },
          "dataQuality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataQualityIssue"
            }
          },
          "distanceKm": {
            "type": "number",
            "description": "Distance from the near point in km. Only present when near is used.",
            "example": 0.412
          }
        }
      },
      "Reading": {
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "voltageR",
          "kwhDelta",
          "kvahDelta"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "End of the interval, ISO 8601 with IST offset.",
            "example": "2026-06-01T00:30:00+05:30"
          },
          "kwh": {
            "type": "number",
            "nullable": true,
            "description": "Cumulative active energy register (odometer), not consumption.",
            "example": 42594.61
          },
          "kvah": {
            "type": "number",
            "nullable": true,
            "description": "Cumulative apparent energy register.",
            "example": 45121.02
          },
          "voltageR": {
            "type": "number",
            "nullable": true,
            "description": "R-phase voltage at the reading time. Never differenced.",
            "example": 230.9
          },
          "kwhDelta": {
            "type": "number",
            "nullable": true,
            "description": "Active energy used during the interval ending at this timestamp. Null for the first reading in the window or after a negative jump.",
            "example": 0.49
          },
          "kvahDelta": {
            "type": "number",
            "nullable": true,
            "description": "Apparent energy used during the interval ending at this timestamp.",
            "example": 0.52
          }
        }
      },
      "Energy": {
        "type": "object",
        "required": [
          "meterId",
          "from",
          "to",
          "granularity",
          "intervalMinutes",
          "units",
          "readings",
          "dataQuality"
        ],
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100001"
          },
          "from": {
            "type": "string",
            "format": "date",
            "example": "2026-06-01"
          },
          "to": {
            "type": "string",
            "format": "date",
            "example": "2026-06-03"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "raw"
            ]
          },
          "intervalMinutes": {
            "type": "integer",
            "nullable": true,
            "description": "Most common gap between readings. Null when there are fewer than two readings.",
            "example": 30
          },
          "units": {
            "type": "object",
            "required": [
              "kwh",
              "kvah",
              "voltageR",
              "kwhDelta",
              "kvahDelta"
            ],
            "properties": {
              "kwh": {
                "type": "string",
                "example": "kWh"
              },
              "kvah": {
                "type": "string",
                "example": "kVAh"
              },
              "voltageR": {
                "type": "string",
                "example": "V"
              },
              "kwhDelta": {
                "type": "string",
                "example": "kWh"
              },
              "kvahDelta": {
                "type": "string",
                "example": "kVAh"
              }
            }
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reading"
            }
          },
          "dataQuality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataQualityIssue"
            }
          }
        }
      },
      "Transformer": {
        "type": "object",
        "required": [
          "code",
          "name",
          "aliases",
          "feederCode",
          "capacityKva",
          "path",
          "meterCount",
          "dataQuality"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "DT-007"
          },
          "name": {
            "type": "string",
            "description": "Official name from the portal's transformer list.",
            "example": "Sanganer DT 7"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other names found for this DT in meter records.",
            "example": [
              "Old Malviya Nagar Xfmr"
            ]
          },
          "feederCode": {
            "type": "string",
            "example": "F-007"
          },
          "capacityKva": {
            "type": "number",
            "example": 250
          },
          "path": {
            "type": "string",
            "nullable": true,
            "description": "Network path of this DT, taken from its meters. Null if it has no meters.",
            "example": "Z-01/C-02/D-01/SD-02/SS-03/F-007/DT-007"
          },
          "meterCount": {
            "type": "integer",
            "example": 13
          },
          "dataQuality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataQualityIssue"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "cache",
          "portal"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "cache": {
            "type": "object",
            "required": [
              "meters",
              "energyEntries"
            ],
            "properties": {
              "meters": {
                "type": "object",
                "required": [
                  "count",
                  "fetchedAt",
                  "stale"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "example": 403
                  },
                  "fetchedAt": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "stale": {
                    "type": "boolean"
                  }
                }
              },
              "energyEntries": {
                "type": "integer",
                "description": "Number of cached energy windows.",
                "example": 12
              }
            }
          },
          "portal": {
            "type": "object",
            "required": [
              "lastSuccessAt",
              "lastError"
            ],
            "properties": {
              "lastSuccessAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "lastError": {
                "type": "string",
                "nullable": true,
                "description": "Error code of the last failed portal call, if the most recent call failed.",
                "example": null
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "validation_error",
                  "not_found",
                  "internal_error",
                  "upstream_error",
                  "upstream_unavailable",
                  "upstream_timeout"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "param",
                    "issue"
                  ],
                  "properties": {
                    "param": {
                      "type": "string",
                      "example": "from"
                    },
                    "issue": {
                      "type": "string",
                      "example": "must be a date in YYYY-MM-DD format"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "DailyUsage": {
        "type": "object",
        "required": [
          "date",
          "kwh",
          "kvah",
          "intervals",
          "expectedIntervals",
          "complete"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-06-01"
          },
          "kwh": {
            "type": "number",
            "description": "Active energy used that day.",
            "example": 24.31
          },
          "kvah": {
            "type": "number",
            "description": "Apparent energy used that day.",
            "example": 26.02
          },
          "intervals": {
            "type": "integer",
            "description": "Intervals of that day with a usable delta.",
            "example": 48
          },
          "expectedIntervals": {
            "type": "integer",
            "description": "Intervals in a full day (48 for half-hourly, 1 for daily meters).",
            "example": 48
          },
          "complete": {
            "type": "boolean",
            "description": "True when every interval of the day is counted. The last day of a window is incomplete, because its final interval ends after the window.",
            "example": true
          }
        }
      },
      "DailyEnergy": {
        "type": "object",
        "required": [
          "meterId",
          "from",
          "to",
          "granularity",
          "intervalMinutes",
          "units",
          "days",
          "dataQuality"
        ],
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100001"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "daily"
            ]
          },
          "intervalMinutes": {
            "type": "integer",
            "nullable": true
          },
          "units": {
            "$ref": "#/components/schemas/Energy/properties/units"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyUsage"
            }
          },
          "dataQuality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataQualityIssue"
            }
          }
        }
      },
      "NodeCounts": {
        "type": "object",
        "required": [
          "meters",
          "byStatus"
        ],
        "properties": {
          "meters": {
            "type": "integer",
            "example": 13
          },
          "byStatus": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Meters by installStatus under this node.",
            "example": {
              "installed": 8,
              "faulty": 3,
              "decommissioned": 2
            }
          }
        }
      },
      "NetworkNode": {
        "type": "object",
        "required": [
          "level",
          "code",
          "name",
          "path",
          "counts",
          "children"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ]
          },
          "code": {
            "type": "string",
            "nullable": true,
            "example": "D-01"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Division 1"
          },
          "path": {
            "type": "string",
            "description": "Identifies the node: codes from zone down to this node.",
            "example": "Z-01/C-01/D-01"
          },
          "counts": {
            "$ref": "#/components/schemas/NodeCounts"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetworkNode"
            }
          },
          "meterIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Meters on this DT (dt level only)."
          }
        }
      },
      "Network": {
        "type": "object",
        "required": [
          "summary",
          "tree"
        ],
        "properties": {
          "summary": {
            "type": "object",
            "required": [
              "meters",
              "nodeCounts",
              "codesUnderMultipleParents"
            ],
            "properties": {
              "meters": {
                "type": "integer",
                "example": 403
              },
              "nodeCounts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "example": {
                  "zone": 3,
                  "circle": 7,
                  "division": 10,
                  "subdivision": 14,
                  "substation": 19,
                  "feeder": 29,
                  "dt": 40
                }
              },
              "codesUnderMultipleParents": {
                "type": "integer",
                "description": "Codes that appear under more than one parent, the reason nodes are keyed by path.",
                "example": 61
              }
            }
          },
          "tree": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetworkNode"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid or unknown parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "validation_error",
                "message": "Invalid request parameters.",
                "details": [
                  {
                    "param": "from",
                    "issue": "must be a date in YYYY-MM-DD format"
                  },
                  {
                    "param": "start",
                    "issue": "unknown parameter"
                  }
                ]
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Meter or route not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "not_found",
                "message": "Meter J999999 not found."
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected error in this service",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "internal_error",
                "message": "Something went wrong."
              }
            }
          }
        }
      },
      "UpstreamError": {
        "description": "The portal returned an unexpected response and no cached copy was available",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "upstream_error",
                "message": "The meter portal returned an unexpected response."
              }
            }
          }
        }
      },
      "UpstreamUnavailable": {
        "description": "The portal is rate limiting or login is failing, and no cached copy was available",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer",
              "example": 30
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "upstream_unavailable",
                "message": "The meter portal is temporarily unavailable. Retry later."
              }
            }
          }
        }
      },
      "UpstreamTimeout": {
        "description": "The portal did not answer in time and no cached copy was available",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "upstream_timeout",
                "message": "The meter portal did not respond in time."
              }
            }
          }
        }
      }
    }
  }
}
